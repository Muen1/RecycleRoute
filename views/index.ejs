<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RecycleRoute Kenya - Empowering Waste Collectors</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Header/Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-recycle me-2"></i>Recycle<span>Route</span> Kenya
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#how-it-works">How It Works</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#dashboard">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#testimonials">Testimonials</a>
                    </li>
                </ul>
                <div class="ms-lg-3">
                    <% if (user) { %>
                        <a href="/logout" class="btn btn-outline-primary me-2">Logout</a>
                    <% } else { %>
                        <a href="#" class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#loginModal">Collector Login</a>
                        <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#loginModal">Admin Dashboard</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <h1>Empowering Waste Collectors in Nairobi</h1>
                    <p>RecycleRoute Kenya provides real-time route and pricing information through USSD technology, helping waste collectors increase income while reducing plastic waste in informal settlements.</p>
                    <div class="hero-btns">
                        <a href="#" class="btn btn-primary">
                            <i class="fas fa-play-circle me-2"></i>Watch Video
                        </a>
                        <a href="#ussd" class="btn btn-outline-primary">
                            <i class="fas fa-mobile-alt me-2"></i>Access USSD
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="features">
        <div class="container">
            <div class="section-title">
                <h2>Our Key Features</h2>
                <p class="text-muted">Technology solutions designed for Nairobi's informal settlements</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-route"></i>
                        </div>
                        <div class="card-body text-center">
                            <h3>Optimized Routes</h3>
                            <p class="text-muted">AI-powered route optimization to maximize collection efficiency and minimize travel time.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="card-body text-center">
                            <h3>Real-time Pricing</h3>
                            <p class="text-muted">Live plastic pricing data from local markets to ensure fair compensation.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                        <div class="card-body text-center">
                            <h3>USSD Access</h3>
                            <p class="text-muted">Works on any mobile phone - no smartphone or internet required.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="card-body text-center">
                            <h3>Mobile Payments</h3>
                            <p class="text-muted">Integrated M-Pesa payments for instant, secure transactions.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="how-it-works">
        <div class="container">
            <div class="section-title">
                <h2>How RecycleRoute Works</h2>
                <p class="text-muted">Simple steps to empower waste collectors</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h3>Access USSD</h3>
                        <p>Collectors dial our USSD code from any mobile phone</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h3>View Routes & Prices</h3>
                        <p>Check optimized routes and current plastic prices</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h3>Collect Plastic</h3>
                        <p>Follow the efficient route to collect plastic waste</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="step-card">
                        <div class="step-number">4</div>
                        <h3>Get Paid</h3>
                        <p>Receive instant payment via mobile money</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Dashboard Preview -->
    <section id="dashboard" class="dashboard-preview">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <h2 class="mb-4">Admin Dashboard</h2>
                    <p class="lead">Our powerful dashboard provides real-time insights into the recycling ecosystem:</p>
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Real-time collector tracking</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Plastic collection analytics</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Payment reconciliation</li>
                        <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i> Route optimization tools</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i> Environmental impact reports</li>
                    </ul>
                    <a href="#" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#loginModal">Explore Dashboard</a>
                </div>
                <div class="col-lg-6">
                    <div class="dashboard-img">
                        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
                             alt="Admin Dashboard" class="img-fluid rounded">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- USSD Section -->
    <section id="ussd" class="ussd-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="mb-4">Accessible on Any Mobile Phone</h2>
                    <p class="lead mb-5">No smartphone? No problem! RecycleRoute works on all mobile devices through USSD technology.</p>
                    
                    <div class="ussd-code">
                        *384*888#
                    </div>
                    
                    <div class="mt-5">
                        <h4 class="mb-3">Follow these simple steps:</h4>
                        <div class="d-flex justify-content-center flex-wrap">
                            <div class="m-3">
                                <div class="bg-white rounded-circle p-3 d-inline-block">
                                    <i class="fas fa-phone-alt text-success fa-2x"></i>
                                </div>
                                <p class="mt-2 mb-0">Dial USSD Code</p>
                            </div>
                            <div class="m-3">
                                <div class="bg-white rounded-circle p-3 d-inline-block">
                                    <i class="fas fa-map-marked-alt text-success fa-2x"></i>
                                </div>
                                <p class="mt-2 mb-0">View Routes & Prices</p>
                            </div>
                            <div class="m-3">
                                <div class="bg-white rounded-circle p-3 d-inline-block">
                                    <i class="fas fa-recycle text-success fa-2x"></i>
                                </div>
                                <p class="mt-2 mb-0">Collect Plastic</p>
                            </div>
                            <div class="m-3">
                                <div class="bg-white rounded-circle p-3 d-inline-block">
                                    <i class="fas fa-money-bill-wave text-success fa-2x"></i>
                                </div>
                                <p class="mt-2 mb-0">Get Paid</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="testimonials">
        <div class="container">
            <div class="section-title">
                <h2>What Collectors Say</h2>
                <p class="text-muted">Real stories from Nairobi's informal settlements</p>
            </div>
            <div class="row">
                <div class="col-md-6 col-lg-4">
                    <div class="testimonial-card">
                        <div class="d-flex align-items-center mb-3">
                            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80" alt="Testimonial">
                            <div>
                                <h5 class="mb-0">Amina Juma</h5>
                                <small>Kibera Collector</small>
                            </div>
                        </div>
                        <p class="mb-0">"RecycleRoute has doubled my income! I now know exactly where to go and get fair prices for my plastic."</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="testimonial-card">
                        <div class="d-flex align-items-center mb-3">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80" alt="Testimonial">
                            <div>
                                <h5 class="mb-0">Samuel Omondi</h5>
                                <small>Mathare Collector</small>
                            </div>
                        </div>
                        <p class="mb-0">"The USSD system is so easy to use. I don't have a smartphone, but I can still access all the information I need."</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="testimonial-card">
                        <div class="d-flex align-items-center mb-3">
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80" alt="Testimonial">
                            <div>
                                <h5 class="mb-0">Grace Atieno</h5>
                                <small>Kawangware Collector</small>
                            </div>
                        </div>
                        <p class="mb-0">"Getting paid instantly through M-Pesa has changed everything. No more waiting for payments!"</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <h5>About RecycleRoute</h5>
                    <p class="mt-4" style="opacity: 0.8;">Empowering waste collectors in Nairobi's informal settlements through technology. Reducing plastic waste while increasing collector income.</p>
                    <div class="social-icons mt-4">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <div class="footer-links mt-4">
                        <a href="#">Home</a>
                        <a href="#features">Features</a>
                        <a href="#how-it-works">How It Works</a>
                        <a href="#dashboard">Dashboard</a>
                        <a href="#testimonials">Testimonials</a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Resources</h5>
                    <div class="footer-links mt-4">
                        <a href="#">For Collectors</a>
                        <a href="#">For Recycling Centers</a>
                        <a href="#">Plastic Pricing Guide</a>
                        <a href="#">Safety Guidelines</a>
                        <a href="#">FAQs</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <h5>Contact Us</h5>
                    <ul class="list-unstyled mt-4" style="opacity: 0.8;">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i> Nairobi, Kenya</li>
                        <li class="mb-2"><i class="fas fa-phone-alt me-2"></i> +254 700 123 456</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i> info@recycleroute.co.ke</li>
                        <li><i class="fas fa-clock me-2"></i> Mon-Fri: 8AM - 5PM</li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                <p>&copy; 2023 RecycleRoute Kenya. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Login to Dashboard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="loginEmail" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" name="password" required>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" name="remember">
                            <label class="form-check-label" for="rememberMe">Remember me</label>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <p class="text-center w-100">Don't have an account? <a href="#" id="registerLink">Register here</a></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>